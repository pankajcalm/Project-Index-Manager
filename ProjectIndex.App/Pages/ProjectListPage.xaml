<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ProjectIndex.App.Pages.ProjectListPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ProjectIndex.Core.Models;assembly=ProjectIndex.Core"
             Title="Project Index"
             BackgroundColor="{AppThemeBinding Light=#F5F5F3, Dark=#1A1A1A}">

    <ContentPage.Resources>
        <Color x:Key="AccentBlue">#378ADD</Color>
        <Color x:Key="CardBg">White</Color>
        <Color x:Key="CardBgDark">#252525</Color>
        <Color x:Key="MutedText">#888780</Color>

        <!-- Status badge colors -->
        <Color x:Key="ActiveBg">#EAF3DE</Color>
        <Color x:Key="ActiveFg">#3B6D11</Color>
        <Color x:Key="PausedBg">#FAEEDA</Color>
        <Color x:Key="PausedFg">#854F0B</Color>
        <Color x:Key="IdeaBg">#EEEDFE</Color>
        <Color x:Key="IdeaFg">#534AB7</Color>
        <Color x:Key="ArchivedBg">#F1EFE8</Color>
        <Color x:Key="ArchivedFg">#5F5E5A</Color>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EBEBEB, Dark=#2C2C2A}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="FilterPicker" TargetType="Picker">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#2C2C2A}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#2C2C2A, Dark=#F1EFE8}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HeightRequest" Value="38" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16,12">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="Project Index"
                       FontSize="22" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#2C2C2A, Dark=#F1EFE8}" />
                <Label x:Name="SubtitleLabel"
                       Text="Loading..."
                       FontSize="12"
                       TextColor="{StaticResource MutedText}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Stats Row -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="8"
              Margin="0,0,0,14">
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="TOTAL" FontSize="10" TextColor="{StaticResource MutedText}" CharacterSpacing="1" />
                    <Label x:Name="StatTotal" Text="0" FontSize="22" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#2C2C2A, Dark=#F1EFE8}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="ACTIVE" FontSize="10" TextColor="{StaticResource MutedText}" CharacterSpacing="1" />
                    <Label x:Name="StatActive" Text="0" FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource ActiveFg}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="PAUSED" FontSize="10" TextColor="{StaticResource MutedText}" CharacterSpacing="1" />
                    <Label x:Name="StatPaused" Text="0" FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource PausedFg}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource StatCard}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="IDEAS" FontSize="10" TextColor="{StaticResource MutedText}" CharacterSpacing="1" />
                    <Label x:Name="StatIdea" Text="0" FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource IdeaFg}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Search + Filters -->
        <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="0,0,0,10">
            <SearchBar x:Name="SearchBar"
                       Placeholder="Search name, tag, path..."
                       TextChanged="OnSearchChanged"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2A}"
                       TextColor="{AppThemeBinding Light=#2C2C2A, Dark=#F1EFE8}"
                       PlaceholderColor="{StaticResource MutedText}"
                       HeightRequest="42" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Picker x:Name="StatusPicker"
                        Grid.Column="0"
                        Title="All statuses"
                        Style="{StaticResource FilterPicker}"
                        SelectedIndexChanged="OnFilterChanged" />
                <Picker x:Name="CategoryPicker"
                        Grid.Column="1"
                        Title="All categories"
                        Style="{StaticResource FilterPicker}"
                        SelectedIndexChanged="OnFilterChanged" />
            </Grid>
        </VerticalStackLayout>

        <!-- Project List -->
        <RefreshView Grid.Row="3"
                     x:Name="RefreshView"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="ProjectsCollection"
                            SelectionMode="None"
                            EmptyView="No projects found.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Project">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Edit"
                                               BackgroundColor="{StaticResource AccentBlue}"
                                               Invoked="OnEditSwiped"
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Delete"
                                               BackgroundColor="#E24B4A"
                                               Invoked="OnDeleteSwiped"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Margin="0,0,0,6"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
                                    StrokeThickness="0.5"
                                    Stroke="{AppThemeBinding Light=#D3D1C7, Dark=#444441}"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="14,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProjectTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5">

                                    <!-- Name + Status Badge -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontSize="15" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#2C2C2A, Dark=#F1EFE8}"
                                               LineBreakMode="TailTruncation" />
                                        <Border Grid.Column="1"
                                                Padding="8,3"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 99"
                                                BackgroundColor="{Binding Status, Converter={StaticResource StatusBgConverter}}">
                                            <Label Text="{Binding Status}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{Binding Status, Converter={StaticResource StatusFgConverter}}" />
                                        </Border>
                                    </Grid>

                                    <!-- Description -->
                                    <Label Grid.Row="1"
                                           Text="{Binding Description}"
                                           FontSize="13"
                                           TextColor="{StaticResource MutedText}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"
                                           IsVisible="{Binding Description, Converter={StaticResource NotNullConverter}}" />

                                    <!-- Path + Category + Tags -->
                                    <HorizontalStackLayout Grid.Row="2" Spacing="6">
                                        <Border Padding="7,3" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4"
                                                BackgroundColor="#E6F1FB"
                                                IsVisible="{Binding Path, Converter={StaticResource NotNullConverter}}">
                                            <Label Text="{Binding Path}"
                                                   FontSize="11"
                                                   TextColor="#185FA5"
                                                   LineBreakMode="TailTruncation"
                                                   WidthRequest="200" />
                                        </Border>
                                        <Border Padding="7,3" StrokeThickness="0.5"
                                                Stroke="#D3D1C7"
                                                StrokeShape="RoundRectangle 4"
                                                IsVisible="{Binding Category, Converter={StaticResource NotNullConverter}}">
                                            <Label Text="{Binding Category}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource MutedText}" />
                                        </Border>
                                    </HorizontalStackLayout>

                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- FAB -->
        <Button Grid.Row="4"
                Text="+ Add Project"
                Clicked="OnAddClicked"
                BackgroundColor="{StaticResource AccentBlue}"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="48"
                Margin="0,10,0,0" />

    </Grid>
</ContentPage>
